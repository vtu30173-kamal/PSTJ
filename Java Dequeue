import java.util.*;

public class test {
    public static void main(String[] args) {
        Scanner in = new Scanner(System.in);
        Deque<Integer> deque = new ArrayDeque<>();
        Set<Integer> set = new HashSet<>();

        int n = in.nextInt();
        int m = in.nextInt();

        int max = 0;

        for (int i = 0; i < n; i++) {
            int num = in.nextInt();

            // Add new element to the window
            deque.addLast(num);
            set.add(num);

            // If window size exceeds m, remove from front
            if (deque.size() > m) {
                int removed = deque.removeFirst();
                // If the removed element is no longer in the window, remove from set
                if (!deque.contains(removed)) {
                    set.remove(removed);
                }
            }

            // When window size is exactly m, update max unique count
            if (deque.size() == m) {
                if (set.size() > max) {
                    max = set.size();
                }
            }
        }

        System.out.println(max);
    }
}

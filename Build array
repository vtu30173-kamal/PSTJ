class Solution {
    public int[] buildArray(int[] nums) {
        int n = nums.length;

        // Store original value + new value
        for (int i = 0; i < n; i++) {
            nums[i] = nums[i] + (nums[nums[i]] % n) * n;
        }

        // Extract the new value
        for (int i = 0; i < n; i++) {
            nums[i] = nums[i] / n;
        }

        return nums;
    }
}
